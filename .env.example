# ResearchMatch environment contract
#
# The buyer should create fresh provider keys. Never paste seller passwords,
# personal API credentials, or bank/tax details into this file. Variables prefixed
# NEXT_PUBLIC_ are shipped to the browser and must never contain private secrets.

# Recommended production identity (buyer-controlled)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_ADMIN_EMAILS=
NEXT_PUBLIC_OPENALEX_MAILTO=
CANONICAL_REDIRECT_HOSTS=researchmatch.site,research-match-three.vercel.app

# Required Supabase project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required AI provider plus optional public-page search enhancement
ANTHROPIC_API_KEY=
SERPER_API_KEY=

# Required Stripe billing configuration
BUYER_STRIPE_ACCOUNT_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PRICE_WEEKLY=
NEXT_PUBLIC_STRIPE_PRICE_SEMESTER=
NEXT_PUBLIC_STRIPE_PRICE_LIFETIME=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_WEEKLY=
STRIPE_PRICE_SEMESTER=
STRIPE_PRICE_LIFETIME=
STRIPE_LEGACY_WEEKLY_PRICE_IDS=
STRIPE_LEGACY_SEMESTER_PRICE_IDS=
STRIPE_LEGACY_LIFETIME_PRICE_IDS=

# Optional setup helpers for Buddy Pass and creator coupons
STRIPE_BUDDY_PASS_COUPON_ID=
STRIPE_AFFILIATE_COUPON_ID=

# Recommended abuse prevention and administration
RATE_LIMIT_SECRET=
ADMIN_EMAILS=

# Optional privacy-limited product analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=

# Optional professor/funding import script settings
PROFESSORS_TABLE=professors
PROFESSORS_ID_COLUMN=id
PROFESSORS_NAME_COLUMN=name
PROFESSORS_INSTITUTION_COLUMN=institution
PROFESSORS_OPENALEX_COLUMN=openalex_author_id
FUNDING_BATCH_SIZE=20
FUNDING_REQUEST_DELAY_MS=450
FUNDING_BATCH_DELAY_MS=1500
FUNDING_MAX_BATCHES=0
